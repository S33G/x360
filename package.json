{
  "name": "x360-field-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An educational Xbox 360 field guide, built from shared Markdown.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:privacy": "node scripts/check-secrets.mjs",
    "check:history": "node scripts/check-secrets.mjs --history",
    "check": "npm run check:types && npm run test && npm run check:nand && npm run check:skills && npm run check:privacy",
    "skills:sync": "node scripts/skill-suite.mjs --write",
    "check:skills": "node scripts/skill-suite.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "check:site": "node --test tests/build-check.mjs && node scripts/check-site.mjs",
    "check:types": "tsc --noEmit",
    "build:nand": "node scripts/build-nand.mjs --sync-skill",
    "check:nand": "node scripts/build-nand.mjs --check-skill"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "mermaid": "12.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "@types/node": "22.18.6"
  }
}
